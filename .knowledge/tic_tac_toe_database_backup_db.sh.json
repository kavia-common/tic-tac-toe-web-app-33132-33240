{"is_source_file": true, "format": "bash", "description": "This is a shell script that detects the running database system (SQLite, PostgreSQL, MySQL, MongoDB) and creates backups accordingly. It handles various database connection scenarios and outputs confirmation messages.", "external_files": ["/usr/lib/postgresql/", "/var/run/mysqld/mysqld.sock"], "external_methods": ["ls", "cp", "sudo -u postgres pg_isready", "sudo mysqladmin", "mysqladmin ping", "mysql", "mysqldump", "mongosh", "mongodump"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/ 2>/dev/null", "cp \"${DB_NAME}\" \"database_backup.db\"", "sudo -u postgres ${PG_BIN}/pg_isready -p ${DB_PORT} > /dev/null 2>&1", "mysqladmin ping -h localhost -P ${DB_PORT} --silent", "sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD}", "mysqldump -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mysql -h localhost -P ${DB_PORT} -u root -p${DB_PASSWORD}", "sudo mysqldump --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet"], "search-terms": ["backup_db.sh", "database backup", "SQLite", "PostgreSQL", "MySQL", "MongoDB", "database detection", "shell script database backup", "database credentials", "database dump"], "state": 2, "file_id": 9, "knowledge_revision": 16, "git_revision": "0781ecbac7af5607111eeb32510345c5d5997e7d", "hash": "d7da372b768c895a33088027314656c3", "format-version": 4, "code-base-name": "tic_tac_toe_database", "filename": "tic_tac_toe_database/backup_db.sh", "revision_history": [{"16": "0781ecbac7af5607111eeb32510345c5d5997e7d"}]}